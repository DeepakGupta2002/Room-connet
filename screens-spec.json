{
  "project": "RoomConnect",
  "spec_version": "1.0",
  "design_strategy": {
    "approach": "mobile_first_responsive",
    "breakpoints": {
      "mobile": "0-640px",
      "tablet": "641-1024px",
      "desktop": "1025px+"
    },
    "desktop_rule": "Same screens and components must adapt; separate desktop pages are not required.",
    "roles": ["seeker", "tenant", "owner", "admin", "moderator"],
    "blocked_roles": ["broker", "agent", "caretaker"],
    "global_rules": {
      "browse_without_login": true,
      "login_required_for_contact": true,
      "tenant_phone_never_exposed": true,
      "owner_approval_required": false,
      "donation_required": false,
      "free_daily_contact_unlock_limit_env": "FREE_DAILY_CONTACT_UNLOCK_LIMIT",
      "donor_daily_contact_unlock_limit_env": "DONOR_DAILY_CONTACT_UNLOCK_LIMIT",
      "donor_access_days_env": "DONOR_ACCESS_DURATION_DAYS"
    }
  },
  "navigation": {
    "mobile_bottom_tabs": ["home", "search", "favorites", "my_listings", "profile"],
    "desktop_navigation": ["home", "search", "post_room", "favorites", "dashboard", "profile"],
    "unauthenticated_routes": ["home", "search_results", "listing_details", "login"],
    "authenticated_routes": ["contact_unlock", "favorites", "dashboard", "my_listings", "post_room", "profile"]
  },
  "screens": [
    {
      "id": "home",
      "route": "/",
      "title": "Find Rooms Without Brokers",
      "access": "public",
      "components": ["top_bar", "header", "location_selector", "search_bar", "quick_filters", "featured_room_cards", "how_it_works", "support_donation_banner"],
      "actions": {"search": "/search", "open_listing": "/rooms/{slug}", "post_room": "/post-room", "login": "/login"},
      "states": ["loading_skeleton", "location_permission_denied", "empty_results", "network_error"],
      "responsive": {"mobile": "single_column_with_sticky_search", "desktop": "wide_header_and_3_4_column_grid"}
    },
    {
      "id": "search_results",
      "route": "/search",
      "title": "Search Rooms",
      "access": "public",
      "components": ["search_bar", "location_summary", "filter_button", "sort_dropdown", "room_cards", "pagination_or_load_more"],
      "filters": ["city", "area", "rent_min", "rent_max", "room_type", "available_from", "furnished", "verified_only"],
      "listing_card_public_fields": ["cover_image", "title", "rent", "city", "area", "available_from", "listed_by_role_label", "verification_badges", "owner_contact_available_label"],
      "hidden_fields": ["tenant_phone", "owner_phone", "exact_address", "private_email"],
      "api": {"method": "GET", "path": "/api/rooms", "pagination_default": 20},
      "states": ["loading_skeleton", "empty_results", "invalid_filter", "network_error"],
      "responsive": {"mobile": "one_column_cards_and_filter_bottom_sheet", "desktop": "filter_sidebar_and_grid"}
    },
    {
      "id": "listing_details",
      "route": "/rooms/{slug}",
      "title": "Room Details",
      "access": "public",
      "components": ["image_gallery", "rent_summary", "availability_dates", "location_summary", "room_description", "amenities", "submitted_by_badge", "verification_badges", "favorite_button", "report_button", "unlock_contact_button"],
      "public_data": ["title", "description", "rent", "deposit", "maintenance", "room_type", "available_from", "leaving_date", "city", "area", "approximate_location", "images", "listed_by_role"],
      "never_return": ["tenant_phone", "owner_phone", "exact_address", "private_email"],
      "actions": {"favorite": "login_required", "report": "login_required", "unlock_contact": "/rooms/{id}/contact"},
      "visibility_rules": {"active": "visible_and_unlock_allowed", "filled": "visible_without_contact_unlock", "expired": "visible_or_archived_by_policy", "flagged": "hidden_or_admin_review_page"},
      "responsive": {"mobile": "gallery_top_and_sticky_unlock_button", "desktop": "gallery_left_details_right"}
    },
    {
      "id": "login",
      "route": "/login",
      "title": "Login with OTP",
      "access": "public",
      "components": ["phone_input", "country_code", "send_otp_button", "otp_input", "resend_timer", "terms_checkbox", "error_message"],
      "flow": ["normalize_phone", "rate_limit_check", "send_otp", "verify_otp", "create_session", "redirect_to_intended_route"],
      "api": {"send_otp": "POST /api/auth/otp/send", "verify_otp": "POST /api/auth/otp/verify"},
      "validation": ["valid_phone", "otp_expiry", "maximum_attempts", "resend_cooldown"],
      "states": ["otp_sent", "invalid_otp", "expired_otp", "too_many_attempts", "blocked_user"]
    },
    {
      "id": "contact_unlock",
      "route": "/rooms/{id}/contact",
      "title": "Unlock Owner Contact",
      "access": "verified_login_required",
      "components": ["listing_summary", "daily_limit_status", "donation_options", "skip_donation_button", "unlock_button", "owner_contact_result"],
      "flow": ["check_session", "check_listing_active", "check_existing_unlock", "check_daily_limit", "optional_donation_or_skip", "authorize", "create_unlock_record", "return_owner_contact"],
      "donation_options": [20, 50, "custom", "skip"],
      "rules": {
        "donation_required": false,
        "same_listing_duplicate_unlock": false,
        "daily_limit_counts_only_new_unlocks": true,
        "tenant_phone_returned": false,
        "owner_phone_requires_consent_and_verification": true,
        "donor_access_days": "DONOR_ACCESS_DURATION_DAYS",
        "free_daily_limit": "FREE_DAILY_CONTACT_UNLOCK_LIMIT",
        "donor_daily_limit": "DONOR_DAILY_CONTACT_UNLOCK_LIMIT"
      },
      "api": {"check": "GET /api/rooms/{id}/contact/eligibility", "unlock": "POST /api/rooms/{id}/contact/unlock"},
      "states": ["already_unlocked", "daily_limit_reached", "donation_pending", "payment_failed", "owner_contact_unavailable", "contact_unlocked"]
    },
    {
      "id": "favorites",
      "route": "/favorites",
      "title": "Saved Rooms",
      "access": "login_required",
      "components": ["saved_room_cards", "remove_favorite", "search_again_button", "empty_state", "loading_skeleton"],
      "api": {"list": "GET /api/favorites", "remove": "DELETE /api/favorites/{post_id}"},
      "responsive": {"mobile": "stacked_cards", "desktop": "grid"}
    },
    {
      "id": "dashboard",
      "route": "/dashboard",
      "title": "Dashboard",
      "access": "login_required",
      "components": ["user_header", "stats_cards", "recent_listings", "recent_unlocks", "donor_status", "quick_actions"],
      "stats": ["total_listings", "active_listings", "filled_listings", "contacts_unlocked"],
      "quick_actions": ["post_room", "my_listings", "favorites", "profile"],
      "responsive": {"mobile": "stacked_cards_and_tabs", "desktop": "sidebar_and_main_content"}
    },
    {
      "id": "my_listings",
      "route": "/my-listings",
      "title": "My Listings",
      "access": "tenant_or_owner_login_required",
      "components": ["status_tabs", "listing_management_cards", "edit_button", "delete_button", "mark_filled_button", "renew_button", "post_room_button"],
      "status_tabs": ["active", "filled", "expired", "flagged", "draft"],
      "rules": {"edit_delete": "creator_or_admin_only", "mark_filled": "creator_owner_or_admin_confirmation", "broker_listing": false},
      "api": {"list": "GET /api/my-listings", "edit": "PATCH /api/posts/{id}", "delete": "DELETE /api/posts/{id}", "filled": "POST /api/posts/{id}/mark-filled"}
    },
    {
      "id": "post_room",
      "route": "/post-room",
      "title": "Post a Room",
      "access": "verified_tenant_or_owner",
      "steps": ["role_selection", "basic_details", "rent_and_charges", "dates", "location", "images", "owner_contact", "preview_and_submit"],
      "fields": ["listed_by_role", "title", "description", "rent_amount", "rent_type", "security_deposit", "maintenance_charge", "room_type", "leaving_date", "available_from", "city", "area", "approximate_address", "latitude", "longitude", "images", "owner_name", "owner_phone", "contact_consent"],
      "validation": ["minimum_title_length", "minimum_description_length", "minimum_two_images", "future_date", "valid_rent", "valid_owner_phone", "broker_role_rejected"],
      "submit_behavior": {"owner_approval_required": false, "initial_status": "active", "verification_status": "phone_verified", "approval_status": "not_required", "slug": "server_generated"},
      "privacy": {"tenant_phone_public": false, "exact_address_public": false, "owner_phone_public": false}
    },
    {
      "id": "edit_listing",
      "route": "/my-listings/{id}/edit",
      "title": "Edit Listing",
      "access": "creator_or_admin",
      "components": ["same_post_room_form", "change_warning", "save_button", "cancel_button"],
      "rules": {"ownership_check": true, "owner_phone_change_requires_verification": true, "major_change_can_trigger_review": true, "slug_user_editable": false},
      "api": {"method": "PATCH", "path": "/api/posts/{id}"}
    },
    {
      "id": "profile",
      "route": "/profile",
      "title": "Profile and Settings",
      "access": "login_required",
      "components": ["profile_form", "phone_verification_status", "donor_status", "privacy_settings", "logout_button", "delete_account_button"],
      "fields": ["name", "email", "phone", "public_donor_name", "show_donation_name"],
      "rules": {"phone_change_requires_otp": true, "sensitive_fields_private_by_default": true}
    },
    {
      "id": "owner_approval",
      "route": "/owner/approve/{token}",
      "title": "Owner Approval",
      "access": "secure_token",
      "components": ["listing_preview", "owner_contact_preview", "approve_button", "reject_button", "reject_reason", "consent_checkbox"],
      "rules": {"token_single_use": true, "token_expiry_required": true, "owner_contact_consent_required": true, "approval_optional_for_mvp": true},
      "actions": {"approve": "POST /api/owner-approvals/{token}/approve", "reject": "POST /api/owner-approvals/{token}/reject"},
      "states": ["valid_token", "expired_token", "already_used", "approved", "rejected"]
    },
    {
      "id": "owner_confirmation",
      "route": "/owner/confirm/{token}",
      "title": "Confirm Room Availability",
      "access": "secure_token",
      "components": ["listing_summary", "still_available_button", "mark_filled_button", "request_edit_button"],
      "rules": {"no_response_action": "mark_unverified_or_hide_after_configured_period", "token_expiry_required": true}
    },
    {
      "id": "admin_dashboard",
      "route": "/admin",
      "title": "Admin Dashboard",
      "access": "admin_only",
      "components": ["system_stats", "pending_reports", "flagged_listings", "user_risk_summary", "donation_summary", "audit_summary"],
      "api": {"stats": "GET /api/admin/dashboard"}
    },
    {
      "id": "moderation",
      "route": "/admin/moderation",
      "title": "Listing Moderation",
      "access": "admin_or_moderator",
      "components": ["filters", "flagged_listing_table", "listing_detail_drawer", "hide_button", "restore_button", "reject_button", "action_reason"],
      "rules": {"three_unique_reports": "temporary_hide_and_review", "duplicate_reports": "ignored", "all_actions_audited": true}
    },
    {
      "id": "users_admin",
      "route": "/admin/users",
      "title": "Users and Blocks",
      "access": "admin_only",
      "components": ["user_search", "user_table", "role_badges", "block_button", "unblock_button", "activity_drawer"],
      "rules": {"broker_agent_accounts": "reject_or_block", "admin_actions_audited": true}
    },
    {
      "id": "donations_admin",
      "route": "/admin/donations",
      "title": "Donations",
      "access": "admin_only",
      "components": ["donation_table", "status_filter", "verified_payment_badge", "refund_action", "donor_privacy_indicator"],
      "rules": {"payment_webhook_verified": true, "payment_ids_private": true, "public_name_requires_opt_in": true}
    },
    {
      "id": "activity_logs_admin",
      "route": "/admin/activity-logs",
      "title": "Activity and Audit Logs",
      "access": "admin_only",
      "components": ["activity_filters", "log_table", "detail_drawer", "export_action"],
      "logged_events": ["login", "otp_failure", "listing_create", "listing_edit", "listing_delete", "contact_unlock", "report", "donation", "admin_action"],
      "never_log": ["raw_otp", "password", "payment_secret"]
    }
  ],
  "shared_ui_states": ["loading", "skeleton", "empty", "validation_error", "unauthorized", "forbidden", "not_found", "rate_limited", "server_error", "retry"],
  "acceptance_rules": [
    "Guest can browse and search without login.",
    "Contact unlock always requires OTP login.",
    "Tenant phone is never returned to a seeker.",
    "Only verified and consented owner contact can be returned after authorization.",
    "Broker and agent listing attempts are rejected.",
    "A user cannot edit or delete another user's listing.",
    "A user cannot create duplicate favorite, report, or contact unlock records for the same listing.",
    "Free and donor daily contact limits are configurable from environment settings.",
    "Donor access expires after the configured number of days.",
    "Public APIs never expose private contact, payment, or exact-address data."
  ]
}
